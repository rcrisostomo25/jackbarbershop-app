# Firebase Runtime Parameters for Cloud Functions
# Use this file to set environment variables for Cloud Functions
#
# Deploy with: firebase deploy --set-env-file=.env.firebase
#
# Docs: https://firebase.google.com/docs/functions/config-env

# Gmail SMTP Configuration
# You can get these values at: https://myaccount.google.com/apppasswords

# Your Gmail address (example: jackbarbershop@gmail.com)
GMAIL_EMAIL=ronald2517@gmail.com

# Gmail App Password - Get from https://myaccount.google.com/apppasswords
# This is a 16-character password generated by Google
# Format: "abcd efgh ijkl mnop" (with spaces)
GMAIL_PASSWORD=fdkg abij evtf xlpi

# Admin email address that receives notifications
# (can be the same as GMAIL_EMAIL)
ADMIN_EMAIL=ronald2517@gmail.com
